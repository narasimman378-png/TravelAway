{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/index.php", "dest": "/api/index.php" },
    { "src": "/about.php", "dest": "/api/about.php" },
    { "src": "/contact.php", "dest": "/api/contact.php" },
    { "src": "/packages.php", "dest": "/api/packages.php" },
    { "src": "/package-details.php", "dest": "/api/package-details.php" },
    { "src": "/places.php", "dest": "/api/places.php" }
  ]
}
